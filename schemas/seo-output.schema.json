{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEOAgentOutput",
  "type": "object",
  "required": ["status", "artifacts", "risks", "next_actions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "fail"]
    },
    "artifacts": {
      "type": "object",
      "required": ["categories", "topic_clusters", "internal_link_rules", "onpage_requirements"],
      "properties": {
        "categories": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "topic_clusters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cluster", "intent", "topics"],
            "properties": {
              "cluster": { "type": "string" },
              "intent": {
                "type": "string",
                "enum": ["informational", "commercial", "navigational", "transactional"]
              },
              "topics": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            }
          }
        },
        "internal_link_rules": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "onpage_requirements": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
