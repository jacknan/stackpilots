{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevAgentOutput",
  "type": "object",
  "required": ["status", "artifacts", "risks", "next_actions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "fail"]
    },
    "artifacts": {
      "type": "object",
      "required": ["file_changes", "env_vars", "ads_plan", "validation_checks"],
      "properties": {
        "file_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "env_vars": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ads_plan": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "validation_checks": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
